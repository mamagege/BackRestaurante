# Copia este archivo como .env y completa los valores (el .env nunca se sube a git).

# ── Seguridad ───────────────────────────────────────────────────────────────
# Clave para firmar los JWT: Base64 de mínimo 256 bits (32 bytes). Obligatoria.
# Genera una con:  openssl rand -base64 48
JWT_SECRET=
# Duración del token en milisegundos (opcional, por defecto 1 hora)
JWT_EXPIRATION_MS=3600000

# Crea un usuario por rol para desarrollo local. NUNCA en QA ni producción.
#   admin@restaurante.com / admin123      mesero@restaurante.com / mesero123
#   cocina@restaurante.com / cocina123    cliente@restaurante.com / cliente123
SEED_ENABLED=true

# Orígenes del front permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Bases de datos (valores por defecto = run-db.ps1 / docker compose) ───────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurante
DB_USER=postgres
DB_PASSWORD=postgres
# Si Mongo exige usuario (docker compose), usa la URI completa:
# SPRING_DATA_MONGODB_URI=mongodb://admin:admin@localhost:27017/restaurante?authSource=admin

# ── Opcionales ───────────────────────────────────────────────────────────────
# HTTPS local con un keystore propio en src/main/resources/restaurante.p12
# SSL_ENABLED=true
# SSL_KEYSTORE_PASSWORD=
# Login con Google: agregar el perfil "oauth" (SPRING_PROFILES_ACTIVE=oauth) y:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
